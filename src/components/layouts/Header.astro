---
import avatar from "../../assets/images/ruben_terre_avatar.png";
import menuMobile from "../../assets/icons/menu_icon_mobile _mini.svg"

const navLinks = [
  { href: "#skills", label: "Habilidades" },
  { href: "#portfolio", label: "Portfolio" },
  { href: "#resume", label: "Trayectoria" },
  { href: "#contact", label: "Contacto" },
];
---

<div class="container">
  <header class="header">
    <div class="header__container">
      <div class="header__bar">
        <div class="header__perfil">
          <div class="header__avatar">
            <img
              src={avatar.src}
              alt="Logo de Rubén Terré"
              width="68"
              height="68"
            />
          </div>

          <div class="header__info">
            <h6 class="header__nombre-marca">Rubén Terré</h6>
            <div class="header__descripcion">Crear y enseñar</div>
          </div>
        </div>

        <nav class="header__nav-desktop" aria-label="Navegación principal">
          {navLinks.map(({ href, label }) => (
            <a href={href} class="header__link">{label}</a>
          ))}
        </nav>

        <div class="header__cta header__cta-desktop">
          <a href="#contact" class="header__a--cta animate-hover-btn">
            Contrátame
          </a>
        </div>

        <button
          class="header__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú"
        >
         <img class="header__icon-mobile" src={menuMobile.src} alt="Icono de menú móvil" width="28" height="28">
        </button>
      </div>

      <div class="header__mobile-panel" id="mobile-menu" hidden>
        <nav class="header__nav-mobile" aria-label="Navegación móvil">
          {navLinks.map(({ href, label }) => (
            <a href={href} class="header__link-mobile">{label}</a>
          ))}
        </nav>

        <div class="header__cta header__cta-mobile">
          <a href="#contact" class="header__a--cta header__a--cta-mobile animate-hover-btn">
            Contrátame
          </a>
        </div>
      </div>
    </div>
  </header>
</div>

<script>
  const toggle = document.querySelector(".header__toggle");
  const panel = document.querySelector("#mobile-menu");

  if (toggle && panel) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      panel.hidden = isOpen;
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        toggle.setAttribute("aria-expanded", "false");
        panel.hidden = true;
      });
    });
  }
</script>


<style lang="scss">
 @use "../../styles/global" as *;

.header {
  padding: 20px;
  isolation: isolate;
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 1000;
  max-width: 1280px;
  margin: 0 auto;
}

@media (min-width: 1150px) {
  .header {
    padding-top: 39px;
  }
}

.header__container {
  display: flex;
  justify-content: center;
  flex-direction: column;
}

.header__bar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  position: relative;
  z-index: 2;
  background: $bg-linear-2;
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.1019607843);
  border-radius: 999px;
  padding: 12px 16px;
}

.header__perfil {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.header__avatar {
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.header__nombre-marca {
  font-family: $font-third;
  font-size: clamp(1rem, 0.95rem + 0.4vw, 1.3rem);
  margin: 0;
  text-rendering: optimizeLegibility;
  font-weight: 500;
  color: $text-light;
}

.header__descripcion {
  font-family: $font-secondary;
  color: $primary;
  font-size: 0.9rem;
  text-transform: uppercase;
}

.header__nav-desktop,
.header__cta-desktop {
  display: none;
}

.header__toggle {
 font-size: 24px;
    padding: 12px;
    border-radius: 50%;
    background: $bg-linear;
    border-top: 1px solid rgba(255, 255, 255, 0.1019607843);
    height: 48px;
    width: 48px;
    display: flex;
    justify-content: center;
    align-items: center;
  cursor: pointer;
  text-decoration: none;
}

.header__mobile-panel {
  margin-top: 0.75rem;
  background: $bg-linear-2;
  backdrop-filter: blur(30px);
  border: 1px solid rgba(255, 255, 255, 0.1019607843);
  border-radius: 24px;
  padding: 2rem 1rem 1.4rem 1rem;
}

.header__nav-mobile {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  justify-content: center;
  align-items: center;
}

.header__link {
  position: relative;
  text-decoration: none;
  font-family: $font-third;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1;
  height: 30px;
  font-size: 1.2rem;
  padding: 10px 0;
  transition: color 0.28s ease, opacity 0.28s ease;
}

.header__link::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 2px;
  width: 100%;
  height: 2px;
  border-radius: 999px;
  background-color: $primary;
  transform: scaleX(0);
  transform-origin: center;
  transition: transform 0.28s ease;
}

@media (hover: hover) and (pointer: fine) {
  .header__link:hover,
  .header__link:focus-visible {
    color: $text-light;
  }

  .header__link:hover::after,
  .header__link:focus-visible::after {
    transform: scaleX(1);
  }
}

.header__link:focus-visible {
  outline: none;
}


.header__link-mobile{
    text-decoration: none;
  font-family: $font-third;
  color: $text-light;
  line-height: 1;
  height: 30px;
  font-size: 1.2rem;
  width: 100%;
  text-align: center;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1019607843);
    margin-bottom: 10px;
    
}

.header__cta-mobile {
  margin-top: 1rem;
  display: flex;
  justify-content: center;
  align-items: center;
}

.header__a--cta {
  min-height: 56px;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  font-size: 16px;
  line-height: 24px;
  width: max-content;
  padding: 0 20px;
  border-radius: 40px;
  gap: 8px;
  background-color: $primary;
  color: $text-dark;
  font-family: $font-secondary;
  font-weight: 600;
  text-decoration: none;
}

.header__a--cta-mobile{
  width: 100%;
}

@media (min-width: 993px) {
  .header__bar {
    padding: 12px 20px 12px 12px;
    gap: 2rem;
  }

  .header__nav-desktop {
    display: flex;
    gap: 20px;
  }

  .header__cta-desktop {
    display: flex;
  }

  .header__toggle,
  .header__mobile-panel {
    display: none;
  }
}

</style>
