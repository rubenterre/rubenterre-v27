<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="row">
      <div class="col s12">
        <div class="main__pills">
          <div class="main__pill">
            <img
              class="main__img"
              src="icons/sections/contact_icon.svg"
              alt="Icono del apartado de contacto"
            />
            <p class="main__tit">Contacto</p>
          </div>
        </div>

        <h2 class="main__h2" id="contact-title">
          ¡Estamos en <span class="main__span">contacto</span>!
        </h2>
        <div class="contact__buttons">
          <a href="mailto:info@rubenterre.com" class="contact__button">
            <div class="contact__img">
              <img
                src="icons/email_icon.svg"
                alt=""
                height="50px"
                class="contact__icon"
              />
            </div>
            <p class="contact__label">Email</p>
            <p class="contact__p">info[arroba]rubenterre.com</p>
          </a>
        </div>
        <div class="contact__socials">
          <h2 class="main__h2 contact__h2">
            No dudes en ponerte en contacto para consultas o colaboraciones.
            Puedes encontrar más de mi trabajo y actualizaciones en mis <span
              class="main__span">redes sociales.</span
            >
          </h2>
          <div class="contact__hub">
            <a
              target="_blank"
              href="https://www.youtube.com/@rubenterre"
              class="contact__social"
            >
              <img
                src="icons/box_icons/youtube_box.svg"
                alt="Enlace a perfil de YouTube"
              />
            </a>
            <a
              target="_blank"
              href="https://www.linkedin.com/in/rubenterrelameiro"
              class="contact__social"
            >
              <img
                src="icons/box_icons/linkedin_box.svg"
                alt="Enlace a perfil de Linkedin"
              />
            </a>
            <a
              target="_blank"
              href="https://www.behance.net/rubenterre"
              class="contact__social"
            >
              <img
                src="icons/box_icons/behance_box.svg"
                alt="Enlace a perfil de Behance"
              />
            </a>
            <a
              target="_blank"
              href="https://github.com/rubenterre"
              class="contact__social"
            >
              <img
                src="icons/box_icons/github_box.svg"
                alt="Enlace a perfil de Github"
              />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/global" as *;

  // Contact

  a {
    text-decoration: none;
  }

  .contact__buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .contact__button {
    border: 1px solid $text-secondary;
    border-radius: 8px;
    background: $bg-linear-2;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    text-align: center;
    padding: 1rem 3.5rem;
    @include hover-effect();
  }

  .contact__img {
    display: flex;
    place-content: center;
    padding: 10px;
  }

  .contact__label {
    font-family: $font-primary;
    color: $text-secondary;
    font-size: 1.1rem;
    margin: 10px 0px;
  }

  .contact__p {
    font-family: $font-primary;
    font-size: 1rem;
    color: white;
    margin-bottom: 20px;
    text-align: center;
  }

  .contact__h2 {
    font-size: 1.3rem;
    max-width: 48ch;
    margin: 0 auto;
    padding: 3rem 0.5rem;
  }

  .contact__hub {
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  .contact__social {
    display: flex;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 8px;

    & img {
      border: 1px solid $text-secondary;
      border-radius: 8px;
      transition: all 0.3s linear;
    }

    &:hover {
      border: 1px solid white;
      border-radius: 8px;

      & img {
        /* border: 1px solid $text-secondary;*/
        border-radius: 8px;
        box-shadow: inset 0px 0px 5px white;
      }
    }
  }

  @media (max-width: 425px) {
    .contact__button {
      width: 100%;
    }
  }
</style>
