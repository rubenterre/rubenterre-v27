---
interface Props {
  apiKey: string;
  channelId: string;
  maxResults?: number;
}

const {
  apiKey,
  channelId,
  maxResults = 3
} = Astro.props;

let videos: any[] = [];

try {
  const url = `https://www.googleapis.com/youtube/v3/search?key=${apiKey}&channelId=${channelId}&part=snippet&order=date&maxResults=${maxResults}`;
  const response = await fetch(url);
  const data = await response.json();
  videos = data.items ?? [];
} catch (error) {
  console.error("Error fetching videos:", error);
}
---

<section class="youtube" id="youtube" aria-labelledby="youtube-title">
  <div class="container">
    <div class="row">
      <div class="col s12">
        <div class="main__pills">
          <div class="main__pill">
            <img
              class="main__img"
              src="/icons/sections/youtube_icon.svg"
              alt="Icono del apartado sobre mis vídeos en YouTube"
            />
            <p class="main__tit">Canal en YouTube</p>
          </div>
        </div>

        <div class="youtube__logo">
          <img
            src="/icons/logos/YouTube_light_logo_(2017).svg"
            alt="Logo de YouTube"
            class="youtube__img"
            width="150"
          />
        </div>

        <h2 class="main__h2" id="youtube-title">
          Echa un ojo a mis últimos <span class="main__span">vídeos</span> en desarrollo
          web.
        </h2>
      </div>

      <div class="col s12">
        <div class="row">
          {videos.length > 0 ? (
            videos.map((video) => (
              <div class="col s12 m4">
                <a
                  href={`https://www.youtube.com/watch?v=${video.id.videoId}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="youtube__a"
                >
                  <picture class="youtube__picture">
                    <img
                      src={video.snippet.thumbnails.high.url}
                      alt={video.snippet.title}
                      width="100%"
                      height="100%"
                      class="youtube__thumbnail"
                      loading="lazy"
                    />
                  </picture>
                </a>
              </div>
            ))
          ) : (
            <p>No se pudieron cargar los vídeos.</p>
          )}
        </div>
      </div>
    </div>

    <div class="col s12">
      <div class="button__btn">
        <a
          href="https://www.youtube.com/@rubenterre?sub_confirmation=1"
          target="_blank"
          rel="noopener noreferrer"
          class="button__button animate-hover-btn"
        >
          <img
            class="youtube__imglink"
            src="/icons/link-icon.svg"
            alt="Icono de enlace al canal de YouTube"
            width="14"
          />
          <p class="youtube__p">Ver el canal de YouTube</p>
        </a>
      </div>
    </div>

    <hr class="main__hr" />
  </div>
</section>

<style lang="scss">
  @use "../../styles/global.scss" as *;

  .youtube {
    margin-bottom: 40px;
  }

  .youtube__logo {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 30px;
  }

  .youtube__picture {
    max-width: 100%;
    width: 100%;
    display: block;
    border: 1px solid $text-secondary;
    border-radius: 8px;
  }

  .youtube__thumbnail {
    overflow: hidden;
    transition: all 0.1s linear;
    pointer-events: none;
    aspect-ratio: 16 / 9;
    width: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .youtube__picture:hover {
    border: 1px solid $primary;
  }

  .youtube__imgcv {
    width: 14px;
  }

  .youtube__p {
    padding-left: 10px;
    font-family: $font-primary;
    font-size: 1.2rem;
    text-align: center;
    text-decoration: none;
  }
</style>
