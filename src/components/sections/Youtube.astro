---
interface Props {
  apiKey: string;
  channelId: string;
  maxResults?: number;
}

const { apiKey, channelId, maxResults = 3 } = Astro.props;

let videos: any[] = [];
let error = "";

try {
  const url = `https://www.googleapis.com/youtube/v3/search?part=snippet&channelId=${channelId}&order=date&maxResults=${maxResults}&type=video&key=${apiKey}`;
  const response = await fetch(url);
  const data = await response.json();

  if (!response.ok) {
    error = data?.error?.message || "No se pudo consultar la API de YouTube.";
  } else {
    videos = (data.items ?? []).filter((video) => video?.id?.videoId);
  }
} catch (err) {
  error = "Error de red al cargar los vídeos.";
  console.error("Error fetching videos:", err);
}
---

<section class="youtube" id="youtube" aria-labelledby="youtube-title">
  <div class="container">
    <div class="row">
      <div class="col s12">
        <div class="main__pills">
          <div class="main__pill">
            <img
              class="main__img"
              src="/icons/sections/youtube_icon.svg"
              alt="Icono del apartado sobre mis vídeos en YouTube"
            />
            <p class="main__tit">Canal en YouTube</p>
          </div>
        </div>

        <div class="youtube__logo">
          <img
            src="/icons/logos/YouTube_light_logo_(2017).svg"
            alt="Logo de YouTube"
            class="youtube__img"
            width="150"
          />
        </div>

        <h2 class="main__h2" id="youtube-title">
          Echa un ojo a mis últimos <span class="main__span">vídeos</span> en desarrollo
          web.
        </h2>
      </div>

      <div class="col s12">
        <div class="row">
          {
            videos.length > 0 ? (
              videos.map((video) => (
                <div class="col s12 m4">
                  <a
                    href={`https://www.youtube.com/watch?v=${video.id.videoId}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="youtube__card-link"
                  >
                    <picture class="youtube__picture">
                      <img
                        src={
                          video.snippet.thumbnails.high?.url ??
                          video.snippet.thumbnails.medium?.url
                        }
                        alt={video.snippet.title}
                        class="youtube__thumbnail"
                        loading="lazy"
                      />
                    </picture>
                  </a>
                </div>
              ))
            ) : (
              <p>{error || "No se pudieron cargar los vídeos."}</p>
            )
          }
        </div>
      </div>
    </div>

    <div class="col s12">
      <div class="youtube__more">
        <a
          href="https://www.youtube.com/@rubenterre?sub_confirmation=1"
          target="_blank"
          rel="noopener noreferrer"
          class="youtube__a youtube__a--more animate-hover-btn"
        >
          VER CANAL DE YOUTUBE
        </a>
      </div>
    </div>

    <hr class="main__hr" />
  </div>
</section>

<style lang="scss">
  @use "../../styles/global.scss" as *;

  .youtube {
    margin-bottom: 40px;
  }

  .youtube__logo {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 30px;
  }

  .youtube__picture {
    max-width: 100%;
    width: 100%;
    display: block;
    border: 1px solid $text-secondary;
    border-radius: 8px;
  }

  .youtube__thumbnail {
    overflow: hidden;
    transition: all 0.1s linear;
    pointer-events: none;
    aspect-ratio: 16 / 9;
    width: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .youtube__picture:hover {
    border: 1px solid $primary;
  }

  .youtube__imgcv {
    width: 14px;
  }

  .youtube__p {
    padding-left: 10px;
    font-family: $font-primary;
    font-size: 1.2rem;
    text-align: center;
    text-decoration: none;
  }

  .youtube__a {
    border: 1px solid $text-secondary;
    width: 100px;
    background-color: $bg-linear;
    text-decoration: none;
    height: 46px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 16px;
    line-height: 24px;
    width: max-content;

    padding: 10px 20px;
    border-radius: 40px;
    gap: 8px;
    color: $text-dark;
    font-family: $font-secondary;
    font-weight: 600;
  }

  .youtube__more {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 20px 0px;
  }

  .youtube__a--more {
    width: 250px;
    font-family: $font-primary;
    font-size: 1.2rem;
    color: white;
  }
</style>
