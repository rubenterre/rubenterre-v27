---
import cv from "../../assets/icons/download.svg";
import linkedin from "../../assets/icons/social/linkedin.svg";
import github from "../../assets/icons/social/github.svg";
import youtube from "../../assets/icons/social/youtube.svg";
import behance from "../../assets/icons/social/behance.svg";

const socials = [
    {icon: linkedin, name: "Linkedin", href: "https://www.linkedin.com/in/rubenterrelameiro/?isSelfProfile=true"},
    {icon: github, name: "GitHub", href: "https://github.com/rubenterre"},
    {icon: youtube, name: "YouTube", href: "https://www.youtube.com/@rubenterre"},
    {icon: behance, name: "Behance", href: "https://www.behance.net/rubenterre"}
]
---

<div class="container">
  <section class="hero">
    <h4 class="hero__h4">
        ¡Hola! Soy
    </h4>
    <h4 class="hero__h4 animationtext terminal">
      <span
        class="hero__text terminal-text text_primary-color"
        data-words='["Desarrollador web","Diseñador gráfico","Docente informático"]'
        data-type-speed="85"
        data-delete-speed="45"
        data-pause="1400"></span>
    </h4>
    <h1 class="hero__h1">creemos juntos</h1>
    <p class="hero__description">
      Explora mis proyectos y descubre cómo puedo ayudarte a llevar tus ideas al
      siguiente nivel.
    </p>
    <div class="col s12">
      <div class="button__btn">
        <a
          href="./Ruben_Arturo_Terre_Lameiro_CV2026.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="button__button animate-hover-btn"
          download="CV de Rubén Terré"
        >
          <img
            class="button__imglink"
            src={cv.src}
            alt="Descarga mi curriculum"
            width="14"
          />
          <p class="button__p">Descarga mi curriculum</p>
        </a>
      </div>

      <div class="hero__social">
        {socials.map(({icon,name,href}) => (
        <a
          class="hero__social-link animate-hover-btn"
          href={href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            class="hero__social-icon"
            src={icon.src}
            alt={name}
            width="28"
            height="28"
          />
        </a>
        ))}
      </div>
    </div>
  </section>
  <hr class="main__hr" />
</div>

<script>
  const terminal = document.querySelector(".terminal-text");

  if (
    terminal &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const words = JSON.parse(terminal.dataset.words || "[]");
    const typeSpeed = Number(terminal.dataset.typeSpeed || 85);
    const deleteSpeed = Number(terminal.dataset.deleteSpeed || 45);
    const pause = Number(terminal.dataset.pause || 1400);

    let wordIndex = 0;
    let charIndex = 0;
    let isDeleting = false;

    function tick() {
      const currentWord = words[wordIndex] || "";

      if (!isDeleting) {
        charIndex++;
        terminal.textContent = currentWord.slice(0, charIndex);

        if (charIndex === currentWord.length) {
          isDeleting = true;
          setTimeout(tick, pause);
          return;
        }

        setTimeout(tick, typeSpeed);
      } else {
        charIndex--;
        terminal.textContent = currentWord.slice(0, charIndex);

        if (charIndex === 0) {
          isDeleting = false;
          wordIndex = (wordIndex + 1) % words.length;
          setTimeout(tick, 250);
          return;
        }

        setTimeout(tick, deleteSpeed);
      }
    }

    if (words.length > 0) {
      tick();
    }
  } else if (terminal) {
    const words = JSON.parse(terminal.dataset.words || "[]");
    terminal.textContent = words[0] || "";
  }
</script>

<style lang="scss">
  @use "../../styles/global.scss" as *;

  .hero {
    padding-top: clamp(7rem, 18vh, 14.5rem);
    display: flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
  }

  .hero__h4 {
    font-family: $font-third;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    margin: 0;
    line-height: 1.1;
    text-rendering: optimizeLegibility;
    font-weight: 500;
    color: $text-light;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero__h1 {
    font-family: $font-third;
    font-size: clamp(2rem, 1.3rem + 4.5vw, 5rem);
    text-transform: uppercase;
    text-align: center;
  }

  .hero__description{
    font-family: $font-primary;
      font-size: clamp(1rem, 0.95rem + 0.35vw, 1.125rem);
  line-height: 1.6;
    max-width: 48ch;
    text-align: center;
  }

  .hero__text {
    color: $primary;
  }

  .terminal-text {
    position: relative;
    display: flex;
    justify-content: start;
    align-items: center;
    min-width: 100%;
    white-space: nowrap;
  }

  .terminal-text::after {
    content: "_";
    display: flex;
    justify-content: start;
    align-items: start;
    margin-left: 2px;
    color: currentColor;
    animation: terminal-caret 0.9s step-end infinite;
  }

  @keyframes terminal-caret {
    0%,
    45% {
      opacity: 1;
    }
    46%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-text::after {
      animation: none;
      opacity: 1;
    }
  }

  .hero__social {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
  }

  .hero__social-link {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 48px;
    width: 48px;
    border-radius: 50%;
    font-size: 24px;
    background: linear-gradient(
      123.51deg,
      rgba(215, 237, 237, 0.1) -61.8%,
      rgba(204, 235, 235, 0.01) 100%
    );
  }
</style>
